import matplotlib.pyplot as plt
import networkx as nx


def dfs(graph, start, goal, visited=None, path=None, traversal=None):
  if visited is None:
    visited = set()
  if path is None:
    path = []
  if traversal is None:
    traversal = []

  visited.add(start)
  path.append(start)
  traversal.append(start)

  if start == goal:
    return path, traversal

  for neighbor in graph.get(start, []):
    if neighbor not in visited:
      result_path, result_traversal = dfs(
          graph, neighbor, goal, visited, path.copy(), traversal
      )
      if result_path:
        return result_path, result_traversal

  return None, traversal


# Graph Representation
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': ['F'],
    'F': [],
}

start_node = 'A'
goal_node = 'F'

path, traversal = dfs(graph, start_node, goal_node)
print('DFS Traversal Order:', traversal)
print('Path to Goal:', path)

# Visualization
plt.figure(figsize=(6, 4))
G = nx.DiGraph(graph)
pos = nx.spring_layout(G)
nx.draw(
    G,
    pos,
    with_labels=True,
    node_color='lightgreen',
    node_size=700,
    arrowsize=20,
)
plt.title('DFS Graph Visualization')
plt.show()
